# Rendered by .github/workflows/release.yml and pushed to fabianmossberg/homebrew-tap.
class Fabpix < Formula
  desc "Search, preview and download stock photos from Pexels in your terminal"
  homepage "https://github.com/fabianmossberg/fabpix"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/fabianmossberg/fabpix/releases/download/v{{VERSION}}/fabpix-darwin-arm64.tar.gz"
      sha256 "{{SHA_DARWIN_ARM64}}"
    end
    on_intel do
      url "https://github.com/fabianmossberg/fabpix/releases/download/v{{VERSION}}/fabpix-darwin-x64.tar.gz"
      sha256 "{{SHA_DARWIN_X64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/fabianmossberg/fabpix/releases/download/v{{VERSION}}/fabpix-linux-arm64.tar.gz"
      sha256 "{{SHA_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/fabianmossberg/fabpix/releases/download/v{{VERSION}}/fabpix-linux-x64.tar.gz"
      sha256 "{{SHA_LINUX_X64}}"
    end
  end

  def install
    bin.install "fabpix"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/fabpix --version")
  end
end
