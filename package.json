{
  "name": "fabpix-workspace",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run packages/cli/src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "bun run --filter '*' build",
    "compile": "bun run --cwd packages/cli compile",
    "compile:all": "bun run --cwd packages/cli compile:all"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
